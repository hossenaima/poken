# Gemini Developer API key (not Vertex). Required.
GEMINI_API_KEY=your_key_here

# Optional: transcript cleanup model (default gemini-2.5-pro for accuracy).
# CLEANUP_MODEL=gemini-2.5-flash

# Seconds one WebSocket connection may live before the server hands the client over to a
# fresh connection. Production sets this to the Cloud Run --timeout (3600). Set it low
# locally, e.g. 120, to rehearse a handover in two minutes.
# SESSION_TIMEOUT_S=3600

# Optional: Gemini Live model for the student's voice (default gemini-3.1-flash-live-preview).
# AUDIO_MODEL=gemini-2.5-flash-native-audio-latest

# Shared key for GET /api/logs (the last 500 server log lines, transcript excerpts included).
# When set, requests must carry ?key=<LOGS_KEY> or get 401. Unset = open (local dev only).
# LOGS_KEY=change-me
